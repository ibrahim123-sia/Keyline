# -----------------------------------------------------------------------------
# Keyline environment variables
# Copy to `.env.local` for local development. Never commit real values.
# In Cloudflare, set plain values as `vars` in wrangler.jsonc and secrets with
# `wrangler secret put <NAME> --env <staging|production>`.
# Integration keys (Google Maps, WhatsApp, Resend, AI provider...) are NOT env
# vars: admins enter them in Admin -> Settings -> Integrations and they are
# stored encrypted in the `secrets` table (see SECRETS_ENCRYPTION_KEY).
# -----------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Public base URL of the site. Used for absolute links (emails, sitemap, OG images, auth callbacks).
APP_URL=http://localhost:3000
# development | staging | production. Staging blocks indexing and should use test keys.
KEYLINE_ENV=development
# Single-tenant agency id written to every main table (`agency_id`). Keep it stable forever.
AGENCY_ID=0192f000-0000-7000-8000-000000000001
# Set to "true" only on the public demo build: enables the read-only viewer account
# and the "Switch demo market" admin action.
DEMO_MODE=false

# --- Database --------------------------------------------------------------
# Local: the PGlite server started by `pnpm db:start` (PostgreSQL 18 + PostGIS, pgvector, pg_trgm, unaccent).
# Production/staging: leave empty; the Hyperdrive binding `HYPERDRIVE` provides the connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Port used by `pnpm db:start`. Its data lives in ~/.keyline/pglite (outside the project, so
# database writes never trigger the dev server's file watcher). Override with DB_DEV_DATA_DIR,
# or move all local data with KEYLINE_DATA_DIR.
DB_DEV_PORT=5433
# Max pool size for Node (dev, scripts). Workers always use a small per-request pool.
DB_POOL_MAX=5

# --- Auth (Better Auth) ----------------------------------------------------
# At least 32 random characters. Rotating it signs everybody out.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Base URL Better Auth uses for callbacks; normally the same as APP_URL.
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in for customers (also needs the toggle in Settings -> Security).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Encryption ------------------------------------------------------------
# 32 random bytes, base64 encoded. Encrypts integration keys at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# --- Internal --------------------------------------------------------------
# Shared secret for /api/internal/* (queue consumer and cron forwarders, dev cron runner).
INTERNAL_JOB_SECRET=replace-with-a-random-string

# --- Storage ---------------------------------------------------------------
# fs  = local folder (default ~/.keyline/media; override with STORAGE_FS_DIR), development and tests
# r2  = Cloudflare R2 binding `MEDIA_BUCKET`
STORAGE_DRIVER=fs

# --- Background jobs ------------------------------------------------------
# inline = run the job in-process right after the response (development, tests)
# queue  = Cloudflare Queues binding `JOBS_QUEUE` (staging, production)
# manual = stay queued until something runs them (automated tests)
JOBS_DRIVER=inline

# --- Cloudflare Turnstile ---------------------------------------------------
# The defaults are Cloudflare's official test keys (always pass). Use real keys in production.
# Set both to "off" to disable the widget and the server check (automated tests only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Rate limits -------------------------------------------------------------
# "off" disables form/login rate limits and the login lockout (automated e2e runs only).
RATE_LIMITS=on

# --- Brochures ----------------------------------------------------------------
# "off" leaves Google Fonts out of brochure PDFs (automated tests: no external requests).
BROCHURE_WEB_FONTS=on
