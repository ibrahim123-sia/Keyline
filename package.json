{
  "name": "propel",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The website, CRM and lead engine for real estate agencies, in one app.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "tsx scripts/db-server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx --import ./scripts/register-server-only.mjs src/db/seed/index.ts",
    "db:reset": "tsx --import ./scripts/register-server-only.mjs scripts/db-reset.ts",
    "admin:create": "tsx --import ./scripts/register-server-only.mjs scripts/create-admin.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "dev:cron": "tsx --import ./scripts/register-server-only.mjs scripts/dev-cron.ts",
    "ai:prompts": "tsx scripts/build-ai-prompts.ts",
    "ai:eval": "tsx --import ./scripts/register-server-only.mjs --import ./scripts/register-next-cache-stub.mjs scripts/ai-eval.ts",
    "ai:backfill": "tsx --import ./scripts/register-server-only.mjs scripts/ai-backfill.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "6.0.0",
    "@opennextjs/cloudflare": "1.20.12",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/extension-blockquote": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "1.7.11",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "0.45.4",
    "heic-to": "1.6.5",
    "lucide-react": "1.59.0",
    "maplibre-gl": "6.13.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "terra-draw": "1.38.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@electric-sql/pglite-postgis": "0.2.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.2"
  }
}
